# فریا روان — تنظیمات امنیتی Apache
Options -Indexes
ServerSignature Off

# حفاظت از فایل‌های حساس
<FilesMatch "^(config\.php|.*\.sql|.*\.log|composer\.(json|lock))$">
  Require all denied
  Deny from all
</FilesMatch>

# صفحه پیش‌فرض
DirectoryIndex index.php

# سازگاری با پیوندهای آپلود قدیمی: هدایت امن assets/uploads به feria-uploads
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/uploads/events/cover-workshop-(.*)$ feria-uploads/workshops/cover-workshop-$1 [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/uploads/events/cover-course-(.*)$ feria-uploads/courses/cover-course-$1 [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/uploads/services/(.*)$ feria-uploads/services/$1 [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/uploads/avatars/(.*)$ feria-uploads/users/$1 [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/uploads/tickets/(.*)$ feria-uploads/tickets/$1 [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/uploads/(.*)$ feria-uploads/$1 [L]
</IfModule>

# ============================================================================
#  ♻ قوانین پیوند یکتا — خودکار تولید می‌شود (نسخهٔ ۱٫۷)
#  این بلوک هنگام تغییر اسلاگ از پیشخوان مدیریت بازنویسی می‌شود؛
#  خارج از نشانگرهای BEGIN/END FERIA دست‌نویس ویرایش کنید.
# ============================================================================
# BEGIN FERIA
<IfModule mod_rewrite.c>
RewriteEngine On
# مسیرهای زیبای هر صفحه (با نصب/بازتولید پیوندها از بخش «پیوندها» تکمیل می‌شود)
# قوانین کلی — برای هر اسلاگ تازه:
RewriteRule ^w/([^/]+)/?$ workshop.php?s=$1 [L,QSA]
RewriteRule ^c/([^/]+)/?$ course.php?s=$1 [L,QSA]
RewriteRule ^t/([^/]+)/?$ test-page.php?s=$1 [L,QSA]
# نقشهٔ سایت
RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>
# END FERIA
